#!/bin/bash
# shutdown-hook.sh - On shutdown:
# 1. Check orientation-lock via gsettings
# 2. If false (auto-rotation ON): save "on", set to true (disable rotation)
# 3. If true (auto-rotation OFF): save "off", do nothing

STATE_FILE="/var/lib/sheng-tablet-mode-state"
SCHEMA="org.gnome.settings-daemon.peripherals.touchscreen"
KEY="orientation-lock"
KNOWN_UID=1000

log() {
    echo "shutdown-hook: $*" >&2
}

main() {
    if [ "$(id -u)" -ne 0 ]; then
        log "not root, skipping"
        return
    fi

    # Find the user by checking /run/user/*/bus directly
    local username=""
    local uid=""
    for d in /run/user/*/; do
        local u=$(basename "$d")
        if [ -f "$d/bus" ]; then
            uid="$u"
            username=$(id -un "$u" 2>/dev/null)
            break
        fi
    done

    if [ -z "$username" ]; then
        log "no user session bus found, trying uid=$KNOWN_UID"
        uid="$KNOWN_UID"
        username=$(id -un "$uid" 2>/dev/null)
    fi

    if [ -z "$username" ]; then
        log "cannot determine username, skipping"
        return
    fi

    local bus="unix:path=/run/user/$uid/bus"
    local lock_value
    lock_value=$(runuser -u "$username" -- env "DBUS_SESSION_BUS_ADDRESS=$bus" \
        gsettings get "$SCHEMA" "$KEY" 2>/dev/null) || { log "cannot read $KEY"; return; }

    if echo "$lock_value" | grep -q "false"; then
        echo "on" > "$STATE_FILE"
        log "was ON, saving 'on', locking orientation"

        runuser -u "$username" -- env "DBUS_SESSION_BUS_ADDRESS=$bus" \
            gsettings set "$SCHEMA" "$KEY" true 2>/dev/null \
            || log "WARNING: failed to set $KEY=true"
    else
        echo "off" > "$STATE_FILE"
        log "was OFF, saving 'off', no change needed"
    fi
}

main "$@"
