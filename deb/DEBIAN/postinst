set -e

# The udev rule must exist before the physical device is enumerated, but this
# rule is installed into the image so the runtime path is covered on boot.
udevadm control --reload-rules 2>/dev/null || true
systemctl daemon-reload 2>/dev/null || true
systemctl enable fake-tablet-mode.service >/dev/null 2>&1 || true

exit 0